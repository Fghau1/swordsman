{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // ========================================================
    //                 🩸 BERSERK FASTFETCH 🩸
    // ========================================================

    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/berserk.png",

        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },

    // ========================================================
    // DISPLAY
    // ========================================================

    "display": {

        "separator": "  ⚔  ",

        "color": {
            "keys": "red",
            "title": "bright_red"
        },

        "key": {
            "width": 15
        }
    },

    // ========================================================
    // MODULES
    // ========================================================

    "modules": [

        // ----------------------------------------------------
        // TITLE
        // ----------------------------------------------------

        {
            "type": "title",
            "format": "⚔ {user-name}@{host-name}"
        },

        "separator",

        // ----------------------------------------------------
        // SYSTEM
        // ----------------------------------------------------

        {
            "type": "os",
            "key": "World"
        },

        {
            "type": "kernel",
            "key": "Struggle"
        },

        {
            "type": "uptime",
            "key": "Vigil"
        },

        {
            "type": "packages",
            "key": "Arsenal"
        },

        // ----------------------------------------------------
        // SHELL / TERMINAL
        // ----------------------------------------------------

        {
            "type": "shell",
            "key": "Weapon"
        },

        {
            "type": "terminal",
            "key": "Camp"
        },

        // ----------------------------------------------------
        // HARDWARE
        // ----------------------------------------------------

        "break",

        {
            "type": "cpu",
            "key": "Strength"
        },

        {
            "type": "gpu",
            "key": "Dragonslayer"
        },

        {
            "type": "memory",
            "key": "Endurance"
        },

        // ----------------------------------------------------
        // COLORS
        // ----------------------------------------------------

        "break",

        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
