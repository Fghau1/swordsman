general {
    colors = true

    interval = 2

    color_good = "#8B0000"
    color_bad = "#B30000"
    color_degraded = "#8A6A32"
}

order += "read_file music"
order += "read_file weather"
order += "wireless _first_"
order += "ethernet _first_"
order += "tztime local"

read_file music {
    path = "/tmp/music_info"
    format = "♬ %content"
}

read_file weather {
    path = "/tmp/weather_info"
    format = "☁ %content"
}

wireless _first_ {
    format_up = "⚔ %essid"
    format_down = "✠ Down"
}

ethernet _first_ {
    format_up = "⚒ Wired"
    format_down = "⚒ Offline"
}

tztime local {
    format = "☩ %Y-%m-%d   %H:%M"
}
