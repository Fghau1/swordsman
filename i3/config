# ============================================================
#                    ⚔ I3 — TEMPLAR PARCHMENT ⚔
# ============================================================

set $mod Mod4

# ------------------------------------------------------------
# FONTE
# ------------------------------------------------------------

font pango:JetBrainsMono Nerd Font 9

# ------------------------------------------------------------
# JANELAS — FERRO / MADEIRA / PERGAMINHO
# ------------------------------------------------------------

default_border pixel 1
default_floating_border pixel 1
hide_edge_borders smart

for_window [class=".*"] title_format "  %title"

# ------------------------------------------------------------
# GAPS
# ------------------------------------------------------------

gaps inner 10
gaps outer 5

smart_gaps off
smart_borders on

# ------------------------------------------------------------
# 🩸 BERSERK PALETTE
# ------------------------------------------------------------

#              BORDER       BACKGROUND    TEXT

client.focused          #8B0000 #111111 #D6D0C4 #B30000 #8B0000
client.focused_inactive #3A3A3A #181818 #AAA49A #181818 #3A3A3A
client.unfocused        #222222 #0B0B0B #77736C #0B0B0B #222222
client.urgent            #B30000 #5C0000 #D6D0C4 #B30000 #B30000
client.placeholder      #0B0B0B #0B0B0B #D6D0C4 #0B0B0B #0B0B0B
client.background       #0B0B0B

# ------------------------------------------------------------
# POPUPS / DIALOGS
# ------------------------------------------------------------

for_window [window_role="pop-up"] floating enable, move position center
for_window [window_role="task_dialog"] floating enable, move position center
for_window [window_role="Preferences"] floating enable, move position center

for_window [window_type="dialog"] floating enable, move position center
for_window [window_type="menu"] floating enable

# ------------------------------------------------------------
# AUTOSTART
# ------------------------------------------------------------

exec --no-startup-id dex --autostart --environment i3

exec_always --no-startup-id ~/.fehbg

exec --no-startup-id xss-lock \
    --transfer-sleep-lock \
    -- i3lock --nofork

exec --no-startup-id picom \
    --config ~/.config/picom/picom.conf

exec --no-startup-id nm-applet

exec_always --no-startup-id ~/.config/i3/scripts/monitores.sh

exec_always --no-startup-id ~/.config/i3/scripts/weather.sh

exec_always --no-startup-id \
    sh -c 'playerctl metadata \
    --format "{{ artist }} - {{ title }}" \
    > /tmp/music_info 2>/dev/null \
    || echo "" > /tmp/music_info'

# ------------------------------------------------------------
# VOLUME
# ------------------------------------------------------------

set $refresh_i3status killall -SIGUSR1 i3status

bindsym XF86AudioRaiseVolume \
    exec --no-startup-id \
    pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status

bindsym XF86AudioLowerVolume \
    exec --no-startup-id \
    pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status

bindsym XF86AudioMute \
    exec --no-startup-id \
    pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status

bindsym XF86AudioMicMute \
    exec --no-startup-id \
    pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# ------------------------------------------------------------
# BRILHO
# ------------------------------------------------------------

bindsym XF86MonBrightnessUp \
    exec --no-startup-id brightnessctl set +10%

bindsym XF86MonBrightnessDown \
    exec --no-startup-id brightnessctl set 10%-

# ------------------------------------------------------------
# FLOATING
# ------------------------------------------------------------

floating_modifier $mod

# ------------------------------------------------------------
# ⚔ GEMINI TERMINAL
# ------------------------------------------------------------

for_window [title="Gemini Terminal"] \
    floating enable, \
    resize set 900 600, \
    move position center

bindsym $mod+Shift+a \
    exec --no-startup-id \
    kitty --title "Gemini Terminal" aichat

# ------------------------------------------------------------
# APLICAÇÕES
# ------------------------------------------------------------

bindsym $mod+Return \
    exec --no-startup-id kitty

bindsym $mod+Shift+q kill

bindsym $mod+d \
    exec --no-startup-id \
    rofi -show drun \
    -theme ~/.config/rofi/config.rasi

bindsym $mod+b \
    exec --no-startup-id firefox

bindsym $mod+Shift+f \
    exec --no-startup-id thunar

bindsym $mod+Shift+s \
    exec --no-startup-id flameshot gui

bindsym $mod+Shift+p \
    exec --no-startup-id \
    ~/.config/i3/scripts/powermenu.sh

bindsym $mod+Ctrl+l \
    exec --no-startup-id \
    betterlockscreen -l dim

# ------------------------------------------------------------
# FOCO
# ------------------------------------------------------------

bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+ccedilla focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# ------------------------------------------------------------
# MOVER JANELAS
# ------------------------------------------------------------

bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+ccedilla move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# ------------------------------------------------------------
# LAYOUT
# ------------------------------------------------------------

bindsym $mod+h split h
bindsym $mod+v split v

bindsym $mod+f fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# ------------------------------------------------------------
# WORKSPACES
# ------------------------------------------------------------

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ------------------------------------------------------------
# 🏰 WALLPAPERS
# ------------------------------------------------------------

bindsym $mod+Ctrl+0 exec --no-startup-id feh --bg-fill ~/Imagens/wallpapers/0.jpg
bindsym $mod+Ctrl+1 exec --no-startup-id feh --bg-fill ~/Imagens/wallpapers/1.jpg
bindsym $mod+Ctrl+2 exec --no-startup-id feh --bg-fill ~/Imagens/wallpapers/2.jpg
bindsym $mod+Ctrl+3 exec --no-startup-id feh --bg-fill ~/Imagens/wallpapers/3.jpg
bindsym $mod+Ctrl+4 exec --no-startup-id feh --bg-fill ~/Imagens/wallpapers/4.jpg
bindsym $mod+Ctrl+5 exec --no-startup-id feh --bg-fill ~/Imagens/wallpapers/5.jpg
bindsym $mod+Ctrl+6 exec --no-startup-id feh --bg-fill ~/Imagens/wallpapers/6.jpg
bindsym $mod+Ctrl+7 exec --no-startup-id feh --bg-fill ~/Imagens/wallpapers/7.jpg
bindsym $mod+Ctrl+8 exec --no-startup-id feh --bg-fill ~/Imagens/wallpapers/8.jpg
bindsym $mod+Ctrl+9 exec --no-startup-id feh --bg-fill ~/Imagens/wallpapers/9.jpg

# ------------------------------------------------------------
# RELOAD / RESTART
# ------------------------------------------------------------

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

bindsym $mod+Shift+e exec \
    "i3-nagbar -t warning \
    -m 'Leave the Kingdom of i3?' \
    -B 'Yes, exit i3' 'i3-msg exit'"

# ------------------------------------------------------------
# RESIZE
# ------------------------------------------------------------

mode "resize" {

    bindsym j resize shrink width 10 px or 10 ppt
    bindsym k resize grow height 10 px or 10 ppt
    bindsym l resize shrink height 10 px or 10 ppt
    bindsym ccedilla resize grow width 10 px or 10 ppt

    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# ============================================================
#                    🛡 TEMPLAR BAR
# ============================================================

bar {
    status_command i3status

    font pango:FiraCode Nerd Font Medium 10

    height 28

    separator_symbol "  ⚔  "

    workspace_buttons yes
    strip_workspace_numbers no

    tray_output primary
    position top

    colors {

        background #0B0B0B
        statusline #D6D0C4
        separator #8B0000

        # Blood — current workspace
        focused_workspace #8B0000 #8B0000 #D6D0C4

        # Iron — active
        active_workspace #2A2A2A #2A2A2A #D6D0C4

        # Darkness — inactive
        inactive_workspace #111111 #111111 #555555

        # Blood rage — urgent
        urgent_workspace #B30000 #5C0000 #D6D0C4

        binding_mode #111111 #111111 #B30000
    }
}
